{
    "name": "hypejunction/hypeinbox",
    "type": "elgg-plugin",
    "description": "Enhanced messaging for Elgg \u2014 multiple inboxes, message threading, and real-time updates.",
    "homepage": "https://github.com/hypeJunction/Elgg3-hypeInbox",
    "keywords": [
        "elgg",
        "plugin",
        "inbox",
        "messages"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypeinbox",
        "elgg-plugin": {
            "id": "hypeinbox"
        }
    },
    "require": {
        "composer/installers": "^2.0",
        "php": ">=8.3",
        "ext-intl": "*",
        "elgg/elgg": "~7.0.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
